# Copy to infra/.env and fill in. Never commit the real .env.

# --- Postgres ---
POSTGRES_USER=devin
POSTGRES_PASSWORD=devin
POSTGRES_DB=devin
POSTGRES_PORT=5432

# --- Redis ---
REDIS_PORT=6379

# --- Mongo ---
MONGO_PORT=27017

# --- MinIO (S3-compatible) ---
MINIO_ROOT_USER=devin
MINIO_ROOT_PASSWORD=devin-minio-secret
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001


LLM_PROVIDER=openrouter
LLM_API_KEY=sk-or-v1-YOUR_OPENROUTER_KEY
LLM_MODEL=openrouter/free

# --- Sandbox gateway (orchestrator -> gateway -> container) ---
GATEWAY_URL=http://127.0.0.1:8080

LLM_FALLBACK_PROVIDER=gemini
LLM_FALLBACK_API_KEY=AIza...   # your Google key
LLM_FALLBACK_MODEL=gemini-2.5-flash

# ANTHROPIC_API_KEY=sk-ant-... 
# OPENAI_API_KEY=sk-...         
# GITHUB_APP_ID=                
# GITHUB_APP_PRIVATE_KEY=       
# JWT_SECRET=                  
