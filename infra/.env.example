# Copy to infra/.env and fill in. Never commit the real .env.

# --- Postgres ---
POSTGRES_USER=devin
POSTGRES_PASSWORD=devin
POSTGRES_DB=devin
POSTGRES_PORT=5432

# --- Redis ---
REDIS_PORT=6379

# --- Mongo ---
MONGO_PORT=27017

# --- MinIO (S3-compatible) ---
MINIO_ROOT_USER=devin
MINIO_ROOT_PASSWORD=devin-minio-secret
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

